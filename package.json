{
  "name": "pokeneuf",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pokeneuf/web dev",
    "data:build": "pnpm --filter @pokeneuf/data data:build",
    "grids:generate": "pnpm --filter @pokeneuf/generator grids:generate",
    "grids:report": "pnpm --filter @pokeneuf/generator grids:report",
    "build": "pnpm -r build",
    "e2e": "pnpm --filter @pokeneuf/web e2e",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
