{
  "name": "@pokeneuf/generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "grids:generate": "tsx src/generate-cli.ts",
