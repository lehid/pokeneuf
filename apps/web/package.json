{
  "name": "@pokeneuf/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "predev": "pnpm --filter @pokeneuf/data data:build",
    "prebuild": "pnpm --filter @pokeneuf/data data:build",
    "pretest": "pnpm --filter @pokeneuf/data data:build",
    "pretypecheck": "pnpm --filter @pokeneuf/data data:build",
    "e2e": "playwright test",
    "assets:build": "tsx scripts/build-assets.ts"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@pokeneuf/core": "workspace:*",
    "downshift": "^9.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@pokeneuf/data": "workspace:*",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.4",
    "workbox-window": "^7.4.1"
  }
}
